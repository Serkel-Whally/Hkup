{
  "name": "xbundle",
  "version": "2.0.0",
  "description": "Mobile data bundles e-commerce platform for Ghana",
  "private": true,
  "workspaces": [
    "packages/frontend",
    "packages/backend"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace @xbundle/frontend dev\" \"yarn workspace @xbundle/backend dev\"",
    "build": "yarn workspace @xbundle/frontend build && yarn workspace @xbundle/backend build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "postcss-selector-parser": "^6.0.16",
    "typescript": "5.3.3"
  }
}
